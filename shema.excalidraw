    {
      "id": "GIs-pJZtVIbv8zJ3m9M_s",
      "type": "text",
      "x": 3917.637460145628,
      "y": 562.7136357245136,
      "width": 906.7677001953125,
      "height": 1710,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1367980073,
      "version": 1633,
      "versionNonce": 999349550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795108375327,
      "link": null,
      "locked": false,
      "text": "fonctionalités:\n    stopper le jeux en appuyant sur une touche\n        detecter une touche\n        stopper le jeux temporairement\n    \n    recup un choix permis les perso \n            afficher les options V\n            recup le choix V\n    ouvrir le menu du personnage\n    save les modif\n\nlogique menu inventaire:\n    transmettre les stat du perso a l'affichage\n    transmettre l'inventaire du perso a l'affichage\n    transmettre l'inventaire du joueur a l'affichage\n    equipement :\n        si un item du meme type est equipé\n            envoyer une erreur\n        sinon \n            equiper \n            envoyer le delta des stat a l'affichage\n\n\nmodif classes :\n    item : boulean equiped\n    item : owner : personnage si equiped sinon joueur\n    \n    creation classe joueur : id, name,inventory\n\n\n     \n    \n    Achaque pause au lieu de sleep j'appelle wait\n\nwait : \n    ecouter pendant x secondes si on ouvre le menu\n\n    si oui on ouvre le menu ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fonctionalités:\n    stopper le jeux en appuyant sur une touche\n        detecter une touche\n        stopper le jeux temporairement\n    \n    recup un choix permis les perso \n            afficher les options V\n            recup le choix V\n    ouvrir le menu du personnage\n    save les modif\n\nlogique menu inventaire:\n    transmettre les stat du perso a l'affichage\n    transmettre l'inventaire du perso a l'affichage\n    transmettre l'inventaire du joueur a l'affichage\n    equipement :\n        si un item du meme type est equipé\n            envoyer une erreur\n        sinon \n            equiper \n            envoyer le delta des stat a l'affichage\n\n\nmodif classes :\n    item : boulean equiped\n    item : owner : personnage si equiped sinon joueur\n    \n    creation classe joueur : id, name,inventory\n\n\n     \n    \n    Achaque pause au lieu de sleep j'appelle wait\n\nwait : \n    ecouter pendant x secondes si on ouvre le menu\n\n    si oui on ouvre le menu ",
      "autoResize": true,
      "lineHeight": 1.25
    },
